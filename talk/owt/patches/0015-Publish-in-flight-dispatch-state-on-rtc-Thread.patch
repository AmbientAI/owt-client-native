From 2fcac33509ef736bbaeb386c7dcce35fcaed9f95 Mon Sep 17 00:00:00 2001
From: ambient <dev@ambient.ai>
Date: Mon, 10 Aug 2026 16:06:54 +0000
Subject: [PATCH] Publish in-flight dispatch state on rtc::Thread

The existing slow-dispatch log only reports messages that have COMPLETED: Dispatch()
times around OnMessage(), so a thread wedged inside a handler is invisible to it and
Thread::Send does not time its waiting side at all. A stall that never resolves
therefore produces no record of where it was.

Thread now publishes the start time and posted-from call site of the dispatch it is
currently running, and CurrentDispatchElapsedMs() lets another thread read it. That
turns a wedge into an observable event with the exact call site, without ptrace,
signals or stack unwinding.

Costs four relaxed atomic stores per dispatch and no additional clock read -
start_time is already computed for the slow-dispatch threshold.
---
 rtc_base/thread.cc | 24 ++++++++++++++++++++++++
 rtc_base/thread.h  | 15 +++++++++++++++
 2 files changed, 39 insertions(+)

diff --git a/rtc_base/thread.cc b/rtc_base/thread.cc
index a8cb022fa9..bd157df008 100644
--- a/rtc_base/thread.cc
+++ b/rtc_base/thread.cc
@@ -661,7 +661,14 @@ void Thread::Dispatch(Message* pmsg) {
                pmsg->posted_from.file_name(), "src_func",
                pmsg->posted_from.function_name());
   int64_t start_time = TimeMillis();
+  // Publish before running. No extra clock read: start_time already exists for the
+  // slow-dispatch log below. file/line first, start last — see thread.h.
+  cur_dispatch_file_.store(pmsg->posted_from.file_name(), std::memory_order_relaxed);
+  cur_dispatch_line_.store(pmsg->posted_from.line_number(), std::memory_order_relaxed);
+  cur_dispatch_start_ms_.store(start_time, std::memory_order_release);
   pmsg->phandler->OnMessage(pmsg);
+  // Clear start first.
+  cur_dispatch_start_ms_.store(0, std::memory_order_release);
   int64_t end_time = TimeMillis();
   int64_t diff = TimeDiff(end_time, start_time);
   if (diff >= kSlowDispatchLoggingThreshold) {
@@ -671,6 +678,23 @@ void Thread::Dispatch(Message* pmsg) {
   }
 }
 
+int64_t Thread::CurrentDispatchElapsedMs(const char** posted_from_file,
+                                        int* posted_from_line) const {
+  const int64_t start = cur_dispatch_start_ms_.load(std::memory_order_acquire);
+  if (start == 0) {
+    return 0;  // not dispatching
+  }
+  if (posted_from_file) {
+    *posted_from_file = cur_dispatch_file_.load(std::memory_order_relaxed);
+  }
+  if (posted_from_line) {
+    *posted_from_line = cur_dispatch_line_.load(std::memory_order_relaxed);
+  }
+  const int64_t elapsed = TimeDiff(TimeMillis(), start);
+  // Never return 0 while dispatching, so callers can use 0 to mean "idle".
+  return elapsed > 0 ? elapsed : 1;
+}
+
 bool Thread::IsCurrent() const {
   return ThreadManager::Instance()->CurrentThread() == this;
 }
diff --git a/rtc_base/thread.h b/rtc_base/thread.h
index 74aab623c8..27c0bf0d9e 100644
--- a/rtc_base/thread.h
+++ b/rtc_base/thread.h
@@ -13,6 +13,8 @@
 
 #include <stdint.h>
 
+#include <atomic>
+
 #include <list>
 #include <map>
 #include <memory>
@@ -260,6 +262,13 @@ class RTC_LOCKABLE RTC_EXPORT Thread : public webrtc::TaskQueueBase {
                      MessageList* removed = nullptr);
   virtual void Dispatch(Message* pmsg);
 
+  // Milliseconds inside the current Dispatch, 0 when not dispatching. Safe to call from
+  // another thread: Location's char* are compile-time literals, so a reader cannot
+  // dangle. The "Message took Nms" log fires only on COMPLETION, leaving a thread wedged
+  // inside OnMessage() invisible to it; this is observable while it is happening.
+  int64_t CurrentDispatchElapsedMs(const char** posted_from_file,
+                                   int* posted_from_line) const;
+
   // Amount of time until the next message can be retrieved
   virtual int GetDelay();
 
@@ -596,6 +605,12 @@ class RTC_LOCKABLE RTC_EXPORT Thread : public webrtc::TaskQueueBase {
   // Runs webrtc::QueuedTask posted to the Thread.
   QueuedTaskHandler queued_task_handler_;
 
+  // Published for CurrentDispatchElapsedMs(). start is stored last and cleared first, so
+  // a reader seeing a non-zero start also sees a coherent file/line.
+  std::atomic<int64_t> cur_dispatch_start_ms_{0};
+  std::atomic<const char*> cur_dispatch_file_{nullptr};
+  std::atomic<int> cur_dispatch_line_{0};
+
   friend class ThreadManager;
 
   RTC_DISALLOW_COPY_AND_ASSIGN(Thread);
-- 
