From 73240849b6953f908eb1c3f3addab332e17c0999 Mon Sep 17 00:00:00 2001
From: ambient <dev@ambient.ai>
Date: Mon, 10 Aug 2026 16:06:54 +0000
Subject: [PATCH] Publish in-flight dispatch state and the OS thread id on
 rtc::Thread

The existing slow-dispatch log only reports messages that have COMPLETED: Dispatch()
times around OnMessage(), so a thread wedged inside a handler is invisible to it and
Thread::Send does not time its waiting side at all. A stall that never resolves
therefore produces no record of where it was.

Thread now publishes the start time and posted-from call site of the dispatch it is
currently running, and CurrentDispatchElapsedMs() lets another thread read it. That
turns a wedge into an observable event with the exact call site, without ptrace,
signals or stack unwinding.

Thread also publishes its OS thread id. Only pthread_t was stored, which cannot be
converted to a tid, so a caller had no way to pair a Thread with /proc/<tid> and read
its wchan without guessing from thread names.

Costs four relaxed atomic stores per dispatch and no additional clock read -
start_time is already computed for the slow-dispatch threshold - plus one store per
thread at startup.
---
 rtc_base/thread.cc | 37 +++++++++++++++++++++++++++++++++++++
 rtc_base/thread.h  | 27 +++++++++++++++++++++++++++
 2 files changed, 64 insertions(+)

diff --git a/rtc_base/thread.cc b/rtc_base/thread.cc
index a8cb022fa9..d915f4fec0 100644
--- a/rtc_base/thread.cc
+++ b/rtc_base/thread.cc
@@ -661,7 +661,24 @@ void Thread::Dispatch(Message* pmsg) {
                pmsg->posted_from.file_name(), "src_func",
                pmsg->posted_from.function_name());
   int64_t start_time = TimeMillis();
+  // Publish before running. No extra clock read: start_time already exists for the
+  // slow-dispatch log below. file/line first, start last — see thread.h.
+  //
+  // Saved and restored rather than cleared to 0: ProcessMessages() is the only caller of
+  // Dispatch, and a handler is free to re-enter it, so dispatches can nest. Clearing
+  // would make the outer handler look idle as soon as an inner one returned — the exact
+  // false negative this exists to prevent. Restoring reports the OUTERMOST dispatch,
+  // which is what answers "how long has this thread been busy".
+  const int64_t prev_start = cur_dispatch_start_ms_.load(std::memory_order_relaxed);
+  const char* prev_file = cur_dispatch_file_.load(std::memory_order_relaxed);
+  const int prev_line = cur_dispatch_line_.load(std::memory_order_relaxed);
+  cur_dispatch_file_.store(pmsg->posted_from.file_name(), std::memory_order_relaxed);
+  cur_dispatch_line_.store(pmsg->posted_from.line_number(), std::memory_order_relaxed);
+  cur_dispatch_start_ms_.store(start_time, std::memory_order_release);
   pmsg->phandler->OnMessage(pmsg);
+  cur_dispatch_file_.store(prev_file, std::memory_order_relaxed);
+  cur_dispatch_line_.store(prev_line, std::memory_order_relaxed);
+  cur_dispatch_start_ms_.store(prev_start, std::memory_order_release);
   int64_t end_time = TimeMillis();
   int64_t diff = TimeDiff(end_time, start_time);
   if (diff >= kSlowDispatchLoggingThreshold) {
@@ -671,6 +688,23 @@ void Thread::Dispatch(Message* pmsg) {
   }
 }
 
+int64_t Thread::CurrentDispatchElapsedMs(const char** posted_from_file,
+                                        int* posted_from_line) const {
+  const int64_t start = cur_dispatch_start_ms_.load(std::memory_order_acquire);
+  if (start == 0) {
+    return 0;  // not dispatching
+  }
+  if (posted_from_file) {
+    *posted_from_file = cur_dispatch_file_.load(std::memory_order_relaxed);
+  }
+  if (posted_from_line) {
+    *posted_from_line = cur_dispatch_line_.load(std::memory_order_relaxed);
+  }
+  const int64_t elapsed = TimeDiff(TimeMillis(), start);
+  // Never return 0 while dispatching, so callers can use 0 to mean "idle".
+  return elapsed > 0 ? elapsed : 1;
+}
+
 bool Thread::IsCurrent() const {
   return ThreadManager::Instance()->CurrentThread() == this;
 }
@@ -824,6 +858,9 @@ void* Thread::PreRun(void* pv) {
   Thread* thread = static_cast<Thread*>(pv);
   ThreadManager::Instance()->SetCurrentThread(thread);
   rtc::SetCurrentThreadName(thread->name_.c_str());
+  // Beside SetCurrentThreadName because both answer "which OS thread is this", and this
+  // is the only place that runs on the thread before its loop starts.
+  thread->tid_.store(rtc::CurrentThreadId(), std::memory_order_relaxed);
   CurrentTaskQueueSetter set_current_task_queue(thread);
 #if defined(WEBRTC_MAC)
   ScopedAutoReleasePool pool;
diff --git a/rtc_base/thread.h b/rtc_base/thread.h
index 74aab623c8..3f88399cba 100644
--- a/rtc_base/thread.h
+++ b/rtc_base/thread.h
@@ -13,6 +13,8 @@
 
 #include <stdint.h>
 
+#include <atomic>
+
 #include <list>
 #include <map>
 #include <memory>
@@ -260,6 +262,20 @@ class RTC_LOCKABLE RTC_EXPORT Thread : public webrtc::TaskQueueBase {
                      MessageList* removed = nullptr);
   virtual void Dispatch(Message* pmsg);
 
+  // Milliseconds inside the current Dispatch, 0 when not dispatching. Safe to call from
+  // another thread: Location's char* are compile-time literals, so a reader cannot
+  // dangle. The "Message took Nms" log fires only on COMPLETION, leaving a thread wedged
+  // inside OnMessage() invisible to it; this is observable while it is happening.
+  int64_t CurrentDispatchElapsedMs(const char** posted_from_file,
+                                   int* posted_from_line) const;
+
+  // OS thread id, 0 before the thread starts. Only pthread_t is stored otherwise, and it
+  // cannot be converted to a tid, so without this a caller cannot pair a Thread with
+  // /proc/<tid> to read wchan.
+  PlatformThreadId os_thread_id() const {
+    return tid_.load(std::memory_order_relaxed);
+  }
+
   // Amount of time until the next message can be retrieved
   virtual int GetDelay();
 
@@ -596,6 +612,17 @@ class RTC_LOCKABLE RTC_EXPORT Thread : public webrtc::TaskQueueBase {
   // Runs webrtc::QueuedTask posted to the Thread.
   QueuedTaskHandler queued_task_handler_;
 
+  // Published for CurrentDispatchElapsedMs(). start is stored last, so a reader seeing a
+  // non-zero start also sees a coherent file/line. Dispatch saves and restores these
+  // rather than clearing them, because dispatches can nest.
+  std::atomic<int64_t> cur_dispatch_start_ms_{0};
+  std::atomic<const char*> cur_dispatch_file_{nullptr};
+  std::atomic<int> cur_dispatch_line_{0};
+
+  // Published once by PreRun, which is the only code that runs on this thread before its
+  // message loop. See os_thread_id().
+  std::atomic<PlatformThreadId> tid_{0};
+
   friend class ThreadManager;
 
   RTC_DISALLOW_COPY_AND_ASSIGN(Thread);
-- 
