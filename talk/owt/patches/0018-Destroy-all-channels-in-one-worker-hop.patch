From: Ambient <eng@ambient.ai>
Date: Thu, 4 Sep 2026 00:00:00 +0000
Subject: [PATCH] Destroy all channels in one worker hop

ChannelManager::Destroy*Channel hops to the worker per channel; hop once instead
and let its IsCurrent() fast path handle the rest. Measured 86.3% of Close().

---
diff -ruN a/pc/peer_connection.cc b/pc/peer_connection.cc
--- a/pc/peer_connection.cc	2026-09-04 15:21:17.639840450 +0000
+++ b/pc/peer_connection.cc	2026-09-04 15:21:18.231094853 +0000
@@ -1111,18 +1111,21 @@
 }
 
 void PeerConnection::DestroyAllChannels() {
-  // Destroy video channels first since they may have a pointer to a voice
-  // channel.
-  for (const auto& transceiver : transceivers_) {
-    if (transceiver->media_type() == cricket::MEDIA_TYPE_VIDEO) {
-      DestroyTransceiverChannel(transceiver);
+  // One hop instead of one per channel: ChannelManager::Destroy*Channel takes its own
+  // IsCurrent() fast path once we are on the worker. Video before audio, as before.
+  worker_thread()->Invoke<void>(RTC_FROM_HERE, [this] {
+    for (const auto& transceiver : transceivers_) {
+      if (transceiver->media_type() == cricket::MEDIA_TYPE_VIDEO) {
+        DestroyTransceiverChannel(transceiver);
+      }
     }
-  }
-  for (const auto& transceiver : transceivers_) {
-    if (transceiver->media_type() == cricket::MEDIA_TYPE_AUDIO) {
-      DestroyTransceiverChannel(transceiver);
+    for (const auto& transceiver : transceivers_) {
+      if (transceiver->media_type() == cricket::MEDIA_TYPE_AUDIO) {
+        DestroyTransceiverChannel(transceiver);
+      }
     }
-  }
+  });
+  // Outside the batch: hops to the network thread, and expects the signaling thread.
   DestroyDataChannelTransport();
 }
 
