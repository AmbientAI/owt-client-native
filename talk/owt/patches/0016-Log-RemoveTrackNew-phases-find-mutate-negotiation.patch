From f5cfe0ec8ed678f76949113287e6d0885aba6fc5 Mon Sep 17 00:00:00 2001
From: ambient-build <build@ambient.ai>
Date: Thu, 20 Aug 2026 13:44:44 +0000
Subject: [PATCH] Log RemoveTrackNew phases: find, mutate, negotiation

OWT DrainPendingStreams attributes ~100% of a hangup teardown to
PeerConnection::RemoveTrack (1054ms with 275 transceivers on
impossiblefoods-redwoodcity-node2, drain_ms 99.2% of 340 samples).

Everything in RemoveTrackNew is local -- it already runs on signaling_thread so
the proxy calls short-circuit -- except UpdateNegotiationNeeded, which calls
Observer()->OnRenegotiationNeeded() and can drive a full offer/answer cycle over
an SDP carrying one m= line per accumulated transceiver. Transceivers were
measured growing 11 -> 286 in 45 minutes for video_tracks=1 throughout.

  event=remove_track_phases transceivers= find_us= mutate_us= negotiation_us= total_us=
  event=remove_track_noop   find_us= transceivers=

find_us covers FindTransceiverBySender, which is a second O(n) scan over the same
list. negotiation_us isolates the renegotiation. Diagnostics only.
---
 pc/peer_connection.cc | 22 ++++++++++++++++++++++
 1 file changed, 22 insertions(+)

diff --git a/pc/peer_connection.cc b/pc/peer_connection.cc
index 14281eb243..6274f46256 100644
--- a/pc/peer_connection.cc
+++ b/pc/peer_connection.cc
@@ -54,6 +54,7 @@
 #include "rtc_base/bind.h"
 #include "rtc_base/checks.h"
 #include "rtc_base/logging.h"
+#include "rtc_base/time_utils.h"
 #include "rtc_base/string_encode.h"
 #include "rtc_base/strings/string_builder.h"
 #include "rtc_base/trace_event.h"
@@ -1648,6 +1649,13 @@ bool PeerConnection::RemoveTrack(RtpSenderInterface* sender) {
 RTCError PeerConnection::RemoveTrackNew(
     rtc::scoped_refptr<RtpSenderInterface> sender) {
   RTC_DCHECK_RUN_ON(signaling_thread());
+  // OWT's DrainPendingStreams attributes ~100% of a hangup teardown to this call
+  // (1054ms with 275 transceivers on a live node). Everything here is local -- the
+  // function already runs on signaling_thread, so the proxy calls short-circuit --
+  // except UpdateNegotiationNeeded, which can drive a full offer/answer cycle over
+  // an SDP carrying one m= line per accumulated transceiver. Timed to say which.
+  const int64_t rt_enter = rtc::TimeMicros();
+  int64_t rt_find_us = 0, rt_mutate_us = 0;
   if (!sender) {
     LOG_AND_RETURN_ERROR(RTCErrorType::INVALID_PARAMETER, "Sender is null.");
   }
@@ -1656,10 +1664,15 @@ RTCError PeerConnection::RemoveTrackNew(
                          "PeerConnection is closed.");
   }
   if (IsUnifiedPlan()) {
+    const int64_t t_find = rtc::TimeMicros();
     auto transceiver = FindTransceiverBySender(sender);
+    rt_find_us = rtc::TimeMicros() - t_find;
     if (!transceiver || !sender->track()) {
+      RTC_LOG(LS_ERROR) << "[CONN-DIAG] event=remove_track_noop find_us="
+                        << rt_find_us << " transceivers=" << transceivers_.size();
       return RTCError::OK();
     }
+    const int64_t t_mut = rtc::TimeMicros();
     sender->SetTrack(nullptr);
     if (transceiver->direction() == RtpTransceiverDirection::kSendRecv) {
       transceiver->internal()->set_direction(
@@ -1668,6 +1681,7 @@ RTCError PeerConnection::RemoveTrackNew(
       transceiver->internal()->set_direction(
           RtpTransceiverDirection::kInactive);
     }
+    rt_mutate_us = rtc::TimeMicros() - t_mut;
   } else {
     bool removed;
     if (sender->media_type() == cricket::MEDIA_TYPE_AUDIO) {
@@ -1682,7 +1696,15 @@ RTCError PeerConnection::RemoveTrackNew(
           "Couldn't find sender " + sender->id() + " to remove.");
     }
   }
+  const int64_t t_neg = rtc::TimeMicros();
   UpdateNegotiationNeeded();
+  const int64_t neg_us = rtc::TimeMicros() - t_neg;
+  RTC_LOG(LS_ERROR) << "[CONN-DIAG] event=remove_track_phases"
+                    << " transceivers=" << transceivers_.size()
+                    << " find_us=" << rt_find_us
+                    << " mutate_us=" << rt_mutate_us
+                    << " negotiation_us=" << neg_us
+                    << " total_us=" << (rtc::TimeMicros() - rt_enter);
   return RTCError::OK();
 }
 
